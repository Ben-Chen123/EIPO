def add_content_to_json_file(new_content, filename):
    if os.path.exists(filename):
             with open(filename, 'r') as f:
                existing_data = json.load(f)
    else:
        existing_data = []
    
    if isinstance(existing_data, list):
        existing_data.append(new_content)  # Append new content if it's a list
    elif isinstance(existing_data, dict):
        if isinstance(new_content, dict):
            existing_data.update(new_content)  # Update if new_content is a dictionary
        else:
            raise ValueError("New content must be a dictionary when existing data is a dictionary.")
    else:
        raise ValueError("Existing data must be a list or dictionary.")

    with open(filename, 'w') as f:
        json.dump(existing_data, f, indent=4)

def get_gpt_response(response):
    response = openai.chat.completions.create(
    model="gpt-3.5-turbo",
    messages=response,
    max_tokens=500,
    temperature=0.5,
    top_p=0.7
    )
    print(response.choices[0].message.content)
    return response.choices[0].message.content

