def get_winner(prompt, response_a, response_b):
    judge_prompt = f"""
    You are an impartial evaluator assessing two AI-generated responses to a user prompt.\n
    Task:\n
    1. Carefully read the user prompt and the two assistant responses labeled A and B.\n
    2. Evaluate the responses based on emotional intelligence principles, including emotional recognition, empathy, tone, supportiveness, and motivation.\n
    3. Determine which response is more emotionally intelligent, helpful, and appropriate given the user's concern.\n
    4. If both responses are equally strong, you may respond with 'Tie'.\n
    Prompt:
    "{prompt}"
    Response A:
    "{response_a}"
    Response B:
    "{response_b}"
    Your output should be a single word: 'A', 'B', or 'Tie'.
    """
    response = openai.chat.completions.create(
    model="gpt-4-turbo",
    messages=[
                {"role": "system", "content": "You are an expert in emotional intelligence and conversational design."},
                {"role": "user", "content": judge_prompt}
            ],
    )
    print(response.choices[0].message.content)
    return response.choices[0].message.content

