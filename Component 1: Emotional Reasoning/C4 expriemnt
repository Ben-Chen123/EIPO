def add_content_to_json_file(new_content, filename):
    if os.path.exists(filename):
             with open(filename, 'r') as f:
                existing_data = json.load(f)
    else:
        existing_data = []
    
    if isinstance(existing_data, list):
        existing_data.append(new_content)  # Append new content if it's a list
    elif isinstance(existing_data, dict):
        if isinstance(new_content, dict):
            existing_data.update(new_content)  # Update if new_content is a dictionary
        else:
            raise ValueError("New content must be a dictionary when existing data is a dictionary.")
    else:
        raise ValueError("Existing data must be a list or dictionary.")

    with open(filename, 'w') as f:
        json.dump(existing_data, f, indent=4)

def get_gpt_response(response):
    response = openai.chat.completions.create(
    model="gpt-3.5-turbo",
    messages=response,
    max_tokens=500,
    temperature=0.5,
    top_p=0.7
    )
    print(response.choices[0].message.content)
    return response.choices[0].message.content

def process_pipeline(input_text):
    """Process user input through classifiers."""
    classifier1_output = pipe_valence(input_text)
    classifier2_output = pipe_labels(input_text)
    classifier3_output = pipe_sublabel(input_text)

    return {
        "classifier1": Valence_mapping.get(classifier1_output[0]["label"], "Unknown Valence"),
        "classifier2": Labels_mapping.get(classifier2_output[0]["label"], "Unknown Label"),
        "classifier3": Sublabel_mapping.get(classifier3_output[0]["label"], "Unknown Sublabel"),
    }

def map_nlu_output_to_action(nlu_output, behaviours_df):
    """Map classified labels to behavior actions from dataset."""
    if nlu_output["classifier2"] in ["Taking Steps", "Commitment"]:
        matching_row = behaviours_df[
            (behaviours_df["Valence"] == nlu_output["classifier1"])
            & (behaviours_df["Label"] == nlu_output["classifier2"])
        ]
    else:
        matching_row = behaviours_df[
            (behaviours_df["Valence"] == nlu_output["classifier1"])
            & (behaviours_df["Label"] == nlu_output["classifier2"])
            & (behaviours_df["Sublabel"] == nlu_output["classifier3"])
        ]

    if not matching_row.empty:
        return matching_row.iloc[0]["Action"], matching_row.iloc[0]["Description"]
    return "No matching action found, continue conversation.", None

